+private fun hlsOutputFileName(baseName: String, isFmp4: Boolean): String {
+    val clean = baseName.removeSuffix(".part")
+    val ext = if (isFmp4) ".mp4" else ".ts"
+    return if (clean.endsWith(".mp4", ignoreCase = true) || clean.endsWith(".ts", ignoreCase = true)) {
+        clean
+    } else {
+        "$clean$ext"
     }
 }
 
+private fun hlsCompanionFileName(baseName: String, suffix: String, ext: String): String {
+    val clean = baseName.removeSuffix(".part").substringBeforeLast('.')
+    return "${clean}_$suffix.$ext"
+}
