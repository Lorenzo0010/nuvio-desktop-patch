+internal fun LazyListScope.patchesPlusSettingsContent(
+    isTablet: Boolean,
+    preloadStreams: Boolean,
+    onPreloadStreamsToggle: (Boolean) -> Unit,
+) {
+    item {
+        DownloadsSettingsRepository.ensureLoaded()
+
+        val autoDownloadSource by DownloadsSettingsRepository.autoDownloadSource.collectAsStateWithLifecycle()
+        val preferredAddonId by DownloadsSettingsRepository.preferredAddonId.collectAsStateWithLifecycle()
+        val preferredRepoId by DownloadsSettingsRepository.preferredRepositoryId.collectAsStateWithLifecycle()
+        val downloadLocationUri by DownloadsSettingsRepository.downloadLocationUri.collectAsStateWithLifecycle()
+
+        val enabledAddons = remember {
+            AddonRepository.uiState.value.addons.enabledAddons()
+        }
+        val repositories = remember {
+            PluginRepository.uiState.value.repositories
+        }
+
+        var showSourceDialog by rememberSaveable { mutableStateOf(false) }
+        var showAddonFilterDialog by rememberSaveable { mutableStateOf(false) }
+        var showRepoFilterDialog by rememberSaveable { mutableStateOf(false) }
+        var showLocationPicker by rememberSaveable { mutableStateOf(false) }
+
+        val openDirectoryFailedText = stringResource(Res.string.downloads_open_directory_failed)
+
+        // Sezione 1: Riproduzione e Dettagli
+        SettingsSection(
+            title = stringResource(Res.string.settings_patches_plus_playback_section),
+            isTablet = isTablet,
+        ) {
+            SettingsGroup(isTablet = isTablet) {
+                SettingsSwitchRow(
+                    title = stringResource(Res.string.settings_meta_preload_streams),
+                    description = stringResource(Res.string.settings_meta_preload_streams_description),
+                    checked = preloadStreams,
+                    isTablet = isTablet,
+                    onCheckedChange = onPreloadStreamsToggle,
+                )
+            }
+        }
+
+        Spacer(modifier = Modifier.height(if (isTablet) NuvioTokens.Space.s18 else MaterialTheme.nuvio.spacing.listGap))
+
+        // Sezione 2: Download Nuvio Plus (Configurazione Sorgente, Cartella e Posizione)
+        SettingsSection(
+            title = "Download (Nuvio Plus)",
+            isTablet = isTablet,
+        ) {
+            SettingsGroup(isTablet = isTablet) {
+                // 1. Sorgente per l'auto-download
+                val sourceLabel = when (autoDownloadSource) {
+                    AutoDownloadSource.BOTH -> "Entrambi (Chi arriva prima)"
+                    AutoDownloadSource.ADDONS -> "Solo Addon (Torrent Cached / HTTP)"
+                    AutoDownloadSource.REPOSITORIES -> "Solo Repository Plugin"
+                }
+
+                SettingsNavigationRow(
+                    title = "Sorgente download automatico",
+                    description = sourceLabel,
+                    icon = Icons.Rounded.CloudDownload,
+                    isTablet = isTablet,
+                    onClick = { showSourceDialog = true },
+                )
+
+                // 2. Filtro Addon (se sorgente = Addons o Both)
+                if (autoDownloadSource == AutoDownloadSource.ADDONS || autoDownloadSource == AutoDownloadSource.BOTH) {
+                    SettingsGroupDivider(isTablet = isTablet)
+                    val currentAddonName = remember(preferredAddonId, enabledAddons) {
+                        if (preferredAddonId.isNullOrBlank()) {
+                            "Tutti gli addon"
+                        } else {
+                            enabledAddons.firstOrNull {
+                                it.manifest?.id == preferredAddonId ||
+                                it.manifestUrl == preferredAddonId ||
+                                it.displayTitle.equals(preferredAddonId, ignoreCase = true) ||
+                                it.manifest?.name?.equals(preferredAddonId, ignoreCase = true) == true
+                            }?.displayTitle ?: preferredAddonId
+                        }
+                    }
+
+                    SettingsNavigationRow(
+                        title = "Filtro Addon",
+                        description = currentAddonName,
+                        icon = Icons.Rounded.Extension,
+                        isTablet = isTablet,
+                        onClick = { showAddonFilterDialog = true },
+                    )
+                }
+
+                // 3. Filtro Repository (se sorgente = Repositories o Both)
+                if (autoDownloadSource == AutoDownloadSource.REPOSITORIES || autoDownloadSource == AutoDownloadSource.BOTH) {
+                    SettingsGroupDivider(isTablet = isTablet)
+                    val currentRepoName = remember(preferredRepoId, repositories) {
+                        if (preferredRepoId.isNullOrBlank()) {
+                            "Tutte le repository"
+                        } else {
+                            repositories.firstOrNull { it.manifestUrl == preferredRepoId || it.name == preferredRepoId }?.name
+                                ?: preferredRepoId
+                        }
+                    }
+
+                    SettingsNavigationRow(
+                        title = "Filtro Repository",
+                        description = currentRepoName,
+                        icon = Icons.Rounded.Source,
+                        isTablet = isTablet,
+                        onClick = { showRepoFilterDialog = true },
+                    )
+                }
+
+                SettingsGroupDivider(isTablet = isTablet)
+
+                // 4. Apri cartella download (spostato dall'header della pagina download)
+                SettingsNavigationRow(
+                    title = stringResource(Res.string.downloads_open_directory),
+                    description = "Accedi ai file multimediali scaricati nel gestore file",
+                    icon = Icons.Rounded.Folder,
+                    isTablet = isTablet,
+                    onClick = {
+                        if (!DownloadsPlatformDownloader.openDownloadsDirectory()) {
+                            NuvioToastController.show(openDirectoryFailedText)
+                        }
+                    },
+                )
+
+                SettingsGroupDivider(isTablet = isTablet)
+
+                // 5. Posizione di download (spostato dall'header/impostazioni della pagina download)
+                SettingsNavigationRow(
+                    title = stringResource(Res.string.settings_downloads_location_title),
+                    description = downloadLocationUri?.let { formatUriForDisplay(it) } ?: stringResource(Res.string.settings_downloads_location_private),
+                    icon = Icons.Rounded.FolderOpen,
+                    isTablet = isTablet,
+                    onClick = { showLocationPicker = true },
+                )
+
+                // 6. Ripristina percorso predefinito se personalizzato
+                if (downloadLocationUri != null) {
+                    SettingsGroupDivider(isTablet = isTablet)
+                    SettingsNavigationRow(
+                        title = stringResource(Res.string.settings_downloads_location_reset),
+                        description = null,
+                        icon = Icons.Rounded.RestartAlt,
+                        isTablet = isTablet,
+                        onClick = { DownloadsSettingsRepository.setDownloadLocationUri(null) },
+                    )
+                }
+            }
+        }
+
+        // Dialog: Selezione Sorgente Auto Download
+        if (showSourceDialog) {
+            AutoDownloadSourceDialog(
+                currentSource = autoDownloadSource,
+                onSourceSelected = { source ->
+                    DownloadsSettingsRepository.setAutoDownloadSource(source)
+                    showSourceDialog = false
+                },
+                onDismiss = { showSourceDialog = false },
+            )
+        }
+
+        // Dialog: Filtro Addon
+        if (showAddonFilterDialog) {
+            AddonFilterDialog(
+                selectedAddonId = preferredAddonId,
+                addons = enabledAddons.map {
+                    val key = it.manifest?.id?.takeIf { id -> id.isNotBlank() } ?: it.manifestUrl
+                    key to it.displayTitle
+                },
+                onAddonSelected = { addonId ->
+                    DownloadsSettingsRepository.setPreferredAddonId(addonId)
+                    showAddonFilterDialog = false
+                },
+                onDismiss = { showAddonFilterDialog = false },
+            )
+        }
+
+        // Dialog: Filtro Repository
+        if (showRepoFilterDialog) {
+            RepositoryFilterDialog(
+                selectedRepoId = preferredRepoId,
+                repositories = repositories.map { it.manifestUrl to it.name },
+                onRepoSelected = { repoId ->
+                    DownloadsSettingsRepository.setPreferredRepositoryId(repoId)
+                    showRepoFilterDialog = false
+                },
+                onDismiss = { showRepoFilterDialog = false },
+            )
+        }
+
+        // Picker posizione download
+        if (showLocationPicker) {
+            DownloadLocationPicker(
+                onLocationSelected = { uri ->
+                    DownloadsSettingsRepository.setDownloadLocationUri(uri)
+                    showLocationPicker = false
+                },
+                onDismiss = { showLocationPicker = false },
+            )
+        }
+    }
+}
